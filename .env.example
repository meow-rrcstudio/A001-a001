# 이 파일은 "어떤 환경변수가 필요한지"만 적어둔 견본입니다.
# ⚠️ 실제 값은 절대 여기 쓰지 마세요 — 이 파일은 커밋됩니다.
#
# 쓰는 법
#   · 로컬에서 npm run dev 를 돌린다면
#       이 파일을 .env.local 로 복사하고 거기에 진짜 값을 채웁니다.
#       (.env.local 은 .gitignore 에 걸려 있어 커밋되지 않습니다)
#   · 실제 사이트(soulseoul.xyz, 그리고 미리보기)는
#       Vercel → Settings → Environment Variables 에 따로 넣습니다.
#       환경변수는 "다음 배포부터" 적용되니, 넣은 뒤 재배포해야 합니다.

# ── 샨티의 타로 해석 ───────────────────────────────────────────────
# platform.openai.com 에서 발급합니다.
# 권한은 "제한된"으로 모델 호출만 허용하는 것을 권합니다.
OPENAI_API_KEY=

# ── 블로그 글 AI 요약 (lib/ai-summary.ts) ──────────────────────────
# 없으면 요약만 건너뛰고 나머지는 정상 동작합니다.
GEMINI_API_KEY=

# ── 캐시 (Upstash Redis) ───────────────────────────────────────────
# 없으면 캐싱만 건너뜁니다. 나중에 리딩 횟수 제한에도 씁니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Notion (블로그 · 아카이빙) ─────────────────────────────────────
# 없으면 글 목록이 빈 채로 뜹니다. 리딩 기능과는 무관합니다.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── 로그인 · 회원 · 기록 (Supabase) ────────────────────────────────
# supabase.com 에서 프로젝트를 만들면 Settings → API 에 다 있습니다.
# 카카오·구글·이메일 로그인은 Supabase 대시보드에서 켭니다
# (Authentication → Providers). 카카오는 개발자센터의 REST API 키,
# 구글은 Google Cloud 의 OAuth 클라이언트를 거기에 넣습니다.
NEXT_PUBLIC_SUPABASE_URL=
# 브라우저에 나가는 키입니다. 나가도 되는 키이지만, RLS 를 켜야
# 안전합니다 (supabase/schema.sql 참고).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ 절대 브라우저로 내보내면 안 되는 키입니다. RLS 를 통째로 무시하므로
#    이 키가 새면 남의 기록도 크레딧도 다 만질 수 있습니다.
#    서버 코드(app/api/**)에서만 쓰세요. NEXT_PUBLIC_ 를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 결제 (토스페이먼츠) ────────────────────────────────────────────
# 카카오페이·네이버페이도 토스페이먼츠 안에서 결제수단으로 켭니다.
# (따로 계약하지 않아도 됩니다)
# 계약 전에는 토스에서 주는 테스트 키로 붙여볼 수 있습니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# ⚠️ 결제 승인에 쓰는 키입니다. 서버에서만 쓰세요.
TOSS_SECRET_KEY=

# ── 사이트 주소 ────────────────────────────────────────────────────
# 사이트맵·RSS 의 절대 주소에 쓰입니다.
NEXT_PUBLIC_BASE_URL=https://soulseoul.xyz
