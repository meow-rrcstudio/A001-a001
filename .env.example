# 이 파일은 "어떤 환경변수가 필요한지"만 적어둔 견본입니다.
# ⚠️ 실제 값은 절대 여기 쓰지 마세요 — 이 파일은 커밋됩니다.
#
# 쓰는 법
#   · 로컬에서 npm run dev 를 돌린다면
#       이 파일을 .env.local 로 복사하고 거기에 진짜 값을 채웁니다.
#       (.env.local 은 .gitignore 에 걸려 있어 커밋되지 않습니다)
#   · 실제 사이트(soulseoul.xyz, 그리고 미리보기)는
#       Vercel → Settings → Environment Variables 에 따로 넣습니다.
#       환경변수는 "다음 배포부터" 적용되니, 넣은 뒤 재배포해야 합니다.

# ── 샨티의 타로 해석 · 블로그 글 요약 ──────────────────────────────
# 해석도 대화도 요약도 전부 제미나이 하나로 갑니다.
# aistudio.google.com/apikey 에서 발급합니다.
#
# ⚠️ OPENAI_API_KEY 는 더 이상 쓰지 않습니다. 예전에 해석을 오픈AI 로
#    부르던 흔적인데, openai 꾸러미를 걷어내면서 부르는 코드가 사라졌습니다.
#    Vercel 에 남아 있다면 지워도 됩니다.
GEMINI_API_KEY=

# ── 어느 모델로 읽을지 (lib/ai/gemini.ts) ──────────────────────────
# 안 넣으면 코드에 적힌 기본값을 씁니다. 평소에는 비워 두세요.
#
# ⚠️ 구글이 모델을 갈아치우며 옛 이름을 닫으면 우리 잘못 없이 404 가
#    옵니다. 실제로 맛보기가 gemini-2.5-flash-lite 404 로 죽었습니다.
#    그럴 때 코드를 고쳐 배포하지 않고 여기서 이름만 바꿔 끼우면 됩니다.
#
# 지금 쓸 수 있는 이름은 이 열쇠로 직접 물어보는 게 가장 확실합니다:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=<열쇠>" \
#     | grep -o '"name": "models/[^"]*"'
GEMINI_MODEL=
GEMINI_FREE_MODEL=
GEMINI_PLAN_MODEL=
GEMINI_FALLBACK_MODEL=

# ── 캐시 · 무료 리딩 총량 (Upstash Redis) ──────────────────────────
# 캐싱과 "무료 리딩을 하루 몇 판까지 내줄지"에 함께 씁니다.
# ⚠️ 없으면 무료 한도를 세지 않고 전부 통과시킵니다(열린 채로 실패).
#    문이 잘못 닫혀 그날 오는 사람을 다 돌려보내는 것보다 낫다는 판단입니다
#    — lib/server/free-quota.ts 에 까닭을 적어뒀습니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 하루에 내줄 무료 리딩 수 (안 넣으면 1000).
# "무료 리딩" = 한 번도 결제한 적 없는 사람이 가입 선물로 보는 판입니다.
# 한 번이라도 산 사람은 이 문을 지나지 않습니다.
FREE_READING_LIMIT=
# 몇 시간마다 채울지 (안 넣으면 6 — 하루 네 번, 00·06·12·18시 한국 시간).
# 24 를 나누어떨어지는 값이어야 합니다.
FREE_READING_WINDOW_HOURS=

# ── Notion (블로그 · 아카이빙) ─────────────────────────────────────
# 없으면 글 목록이 빈 채로 뜹니다. 리딩 기능과는 무관합니다.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── 로그인 · 회원 · 기록 (Supabase) ────────────────────────────────
# supabase.com 에서 프로젝트를 만들면 Settings → API 에 다 있습니다.
# 카카오·구글·이메일 로그인은 Supabase 대시보드에서 켭니다
# (Authentication → Providers). 카카오는 개발자센터의 REST API 키,
# 구글은 Google Cloud 의 OAuth 클라이언트를 거기에 넣습니다.
# 이름은 Supabase 대시보드가 알려주는 것과 똑같이 맞췄습니다.
# 앞의 NEXT_PUBLIC_ 만 다릅니다 — 그게 붙어야 브라우저에서도 읽힙니다.
#
#   Supabase 화면                 여기에 넣을 이름
#   SUPABASE_URL              →   NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY  →   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SECRET_KEY       →   SUPABASE_SECRET_KEY  (그대로)
#   SUPABASE_JWKS_URL         →   안 씁니다
NEXT_PUBLIC_SUPABASE_URL=

# 브라우저에 나가는 키입니다. 나가도 되는 키이지만, RLS 를 켜야
# 안전합니다 (supabase/schema.sql 참고).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ 절대 브라우저로 내보내면 안 되는 키입니다. RLS 를 통째로 무시하므로
#    이 키가 새면 남의 기록도 크레딧도 다 만질 수 있습니다.
#    서버 코드(app/api/**)에서만 쓰세요. NEXT_PUBLIC_ 를 붙이지 마세요.
SUPABASE_SECRET_KEY=

# ── 로그인 버튼 켜고 끄기 ──────────────────────────────────────────
# 카카오·구글은 바깥 콘솔 설정이 맞아야만 동작합니다.
#
# 기본은 "보임"입니다. 비워 두면 버튼이 나옵니다.
# 감추려면 정확히 off 를 넣으세요 — 다른 값은 무시되고 보입니다.
# ⚠️ NEXT_PUBLIC_ 는 빌드에 박히므로, 값을 바꾼 뒤 반드시 재배포해야 합니다.
NEXT_PUBLIC_LOGIN_KAKAO=
NEXT_PUBLIC_LOGIN_GOOGLE=

# 카카오에서 이메일까지 받을지.
# ⚠️ 순서를 지켜야 합니다. 카카오 개발자센터에서 비즈 앱 전환 →
#    동의항목(카카오계정 이메일)을 먼저 켜고, 그 다음에 여기를 on 으로.
#    반대로 하면 카카오가 로그인 창 대신 KOE205 를 띄웁니다.
#    되돌리려면 이 값만 지우고 재배포하면 됩니다.
NEXT_PUBLIC_KAKAO_EMAIL=

# ── 결제 (토스페이먼츠) ────────────────────────────────────────────
# 카카오페이·네이버페이도 토스페이먼츠 안에서 결제수단으로 켭니다.
# (따로 계약하지 않아도 됩니다)
#
# ┌─ 계약 전에 테스트로 붙여보기 ─────────────────────────────────────
# │ 토스페이먼츠 개발자센터 → 내 개발정보 → "테스트" 탭에서 두 키를
# │ 그대로 복사해 넣습니다. 계약도 심사도 필요 없습니다.
# │   클라이언트 키  test_ck_... → NEXT_PUBLIC_TOSS_CLIENT_KEY
# │   시크릿 키      test_sk_... → TOSS_SECRET_KEY
# │
# │ 키가 test_ 로 시작하면 크레딧 화면에 "지금은 테스트 결제예요"가
# │ 뜹니다 (lib/toss-client.ts 의 isTossTestKey). 실제로 돈은 안 나갑니다.
# │
# │ ⚠️ 둘 다 넣어야 합니다. 클라이언트 키만 넣으면 버튼은 보이는데
# │    누르면 "결제가 아직 열리지 않았어요"가 뜹니다 (서버가 승인 키까지
# │    있어야 주문을 만들어 주기 때문입니다).
# │
# │ ⚠️ NEXT_PUBLIC_ 은 빌드에 박힙니다. Vercel 에 넣은 뒤 반드시
# │    재배포해야 버튼이 나옵니다.
# └──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# ⚠️ 결제 승인에 쓰는 키입니다. 서버에서만 쓰세요.
TOSS_SECRET_KEY=

# ── 사이트 주소 ────────────────────────────────────────────────────
# 사이트맵·RSS 의 절대 주소에 쓰입니다.
NEXT_PUBLIC_BASE_URL=https://soulseoul.xyz
